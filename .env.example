# InsForge Backend (Target API URL for client and server)
NEXT_PUBLIC_INSFORGE_URL=https://<project-id>.<region>.insforge.app
API_BASE_URL=https://<project-id>.<region>.insforge.app
INSFORGE_BASE_URL=https://<project-id>.<region>.insforge.app

# InsForge Authentication (Secret API key for MCP and server-side calls)
API_KEY=ik_your_insforge_api_key
INSFORGE_API_KEY=ik_your_insforge_api_key
NEXT_PUBLIC_INSFORGE_ANON_KEY=ik_your_insforge_anon_key

# AI Gateway (100% Free Tier via Google AI Studio - Gemini 3.5 Flash-Lite)
GEMINI_API_KEY=your_gemini_api_key
# OPENROUTER_API_KEY is NOT required (optional, only if using OpenRouter later)
# OPENROUTER_API_KEY=your_openrouter_api_key

# Slack OAuth Credentials
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret
SLACK_REDIRECT_URI=http://localhost:3000/api/integrations/slack/callback
