# InsForge Backend (Target API URL for client and server)
NEXT_PUBLIC_INSFORGE_URL=https://<project-id>.<region>.insforge.app
API_BASE_URL=https://<project-id>.<region>.insforge.app
INSFORGE_BASE_URL=https://<project-id>.<region>.insforge.app

# InsForge Authentication (Secret API key for MCP and server-side calls)
API_KEY=ik_your_insforge_api_key
INSFORGE_API_KEY=ik_your_insforge_api_key

# AI Gateway (Server-side key for OpenRouter AI integrations)
OPENROUTER_API_KEY=your_openrouter_api_key
